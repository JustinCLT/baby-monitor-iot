# Ganti PROJECT_ID dengan nama unik kelompokmu (huruf, angka, - dan _)
PROJECT_ID=kelas_iot_kelompok_07

# Broker publik HiveMQ: tanpa daftar akun
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true

# Kosongkan untuk broker publik. Isi jika memakai broker pribadi (EMQX Cloud, HiveMQ Cloud, dll.)
MQTT_USERNAME=
MQTT_PASSWORD=
